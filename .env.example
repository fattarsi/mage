# Copy this to ".env" (which is git-ignored) and fill in your own values.
# Nothing here is committed-specific — it documents the optional local config.

# Optional external deck source: a self-hosted "Deck Manager" REST API used to
# load saved decks and enable Commander games. Leave empty to play with pasted
# or random decks only.
#   docker compose: read automatically from .env
#   local run:      ./run-web.sh reads .env, or export it in your shell
XMAGE_WEB_DECK_SOURCE_URL=
